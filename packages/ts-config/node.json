{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SARKO Node (NestJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "outDir": "dist",
    "rootDir": "src",

    "isolatedModules": false
  }
}
