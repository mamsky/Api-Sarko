# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ─── Datastores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sarko:sarko@localhost:5432/sarko
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Object storage (MinIO / S3) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=sarko-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Payment gateway ────────────────────────────────────────────────────────
PAYMENT_GATEWAY_NAME=midtrans
PAYMENT_GATEWAY_BASE_URL=https://api.sandbox.midtrans.com
PAYMENT_GATEWAY_SERVER_KEY=sandbox-server-key
PAYMENT_GATEWAY_CLIENT_KEY=sandbox-client-key
PAYMENT_GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_GATEWAY_WEBHOOK_TOLERANCE_SECONDS=300

# ─── LAN Hub ────────────────────────────────────────────────────────────────
HUB_KEY_PEPPER=change-me-hub-key-pepper

# ─── Business rules ─────────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Jakarta
BUSINESS_CUTOFF_HOUR=4
